      "cronograma": {
        ".read":  true,
        ".write": "auth != null && (root.child('madrid_data/master_admins/' + auth.token.email.replace('.','_').replace('#','_').replace('$','_').replace('[','_').replace(']','_')).exists() || root.child('madrid_data/permissions/' + auth.token.email.replace('.','_').replace('#','_').replace('$','_').replace('[','_').replace(']','_') + '/role').val() === 'gestor')",
        "geral_percentual": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "proxima_etapa":    { ".validate": "newData.isString() && newData.val().length <= 80" },
        "etapas": {
          "$idx": {
            ".validate": "newData.hasChildren(['nome','percentual','status'])",
            "nome":       { ".validate": "newData.isString() && newData.val().length <= 40" },
            "percentual": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "status":     { ".validate": "newData.isString() && newData.val().matches(/^(pendente|ativa|concluida)$/)" },
            "icone":      { ".validate": "newData.isString() && newData.val().length <= 30" }
          }
        }
      },

      "audit_log": {
        ".read":  "auth != null && (root.child('madrid_data/master_admins/' + auth.token.email.replace('.','_').replace('#','_').replace('$','_').replace('[','_').replace(']','_')).exists() || root.child('madrid_data/permissions/' + auth.token.email.replace('.','_').replace('#','_').replace('$','_').replace('[','_').replace(']','_') + '/role').val() === 'gestor')",
        "$auditId": {
          ".write": "auth != null && (root.child('madrid_data/master_admins/' + auth.token.email.replace('.','_').replace('#','_').replace('$','_').replace('[','_').replace(']','_')).exists() || root.child('madrid_data/permissions/' + auth.token.email.replace('.','_').replace('#','_').replace('$','_').replace('[','_').replace(']','_') + '/role').val() === 'gestor') && !data.exists() && newData.exists()",
          ".validate": "newData.hasChild('action') && newData.hasChild('user') && newData.hasChild('timestamp') && newData.child('user').val() === auth.token.email"
        }
      },

      "logs": {
        ".read":  "auth != null && (root.child('madrid_data/master_admins/' + auth.token.email.replace('.','_').replace('#','_').replace('$','_').replace('[','_').replace(']','_')).exists() || root.child('madrid_data/permissions/' + auth.token.email.replace('.','_').replace('#','_').replace('$','_').replace('[','_').replace(']','_') + '/role').val() === 'gestor')",
        "$date": {
          "$emailKey": {
            ".write": "auth != null && root.child('madrid_data/permissions/' + auth.token.email.replace('.','_').replace('#','_').replace('$','_').replace('[','_').replace(']','_')).exists() && $emailKey === auth.token.email.replace('.','_').replace('#','_').replace('$','_').replace('[','_').replace(']','_') && newData.exists()",
            ".validate": "newData.hasChildren(['email', 'lastLogin']) && $emailKey === auth.token.email.replace('.','_').replace('#','_').replace('$','_').replace('[','_').replace(']','_') && newData.child('email').val() === auth.token.email"
          }
        }
      }
    }
  }
}
